# Configurações de Ambiente — NEXUS9
# Copie este arquivo para .env se desejar customizar os padrões de execução local

# Perfil de Hardware: 'light' (para dual-core/economico) ou 'standard'
NEXUS9_HARDWARE=light

# Diretório raiz padrão para varreduras de código
# NEXUS9_WORKSPACE=C:\caminho\para\seu\projeto

# Nível de logging interno do servidor MCP: DEBUG, INFO, WARNING, ERROR
NEXUS9_LOG_LEVEL=INFO

# Diretório customizado para armazenamento do banco SQLite3 de estado (Opcional)
# NEXUS9_STATE_DIR=%LOCALAPPDATA%\Nexus9
